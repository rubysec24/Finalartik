{
  "version": 2,
  "buildCommand": "bash ./vercel-build.sh",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["fra1"],
  "env": {
    "NEXT_PUBLIC_BASE_URL": "https://www.kurmay.com.tr",
    "SKIP_INSTALL_DEPS": "canvas"
  },
  "installCommand": "npm install --no-optional",
  "ignoreCommand": "node -e \"process.exit(0)\"",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ]
} 